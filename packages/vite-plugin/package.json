{
  "name": "@ai-request-guard/vite-plugin",
  "version": "1.0.5",
  "description": "Vite plugin for AIRequestGuard — real-request interception and schema diff HTML report",
  "keywords": [
    "vite-plugin",
    "ai-request-guard",
    "anti-corruption-layer",
    "schema-diff",
    "fetch-interceptor",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jipengju-GitHub/ai-request-guard.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://guard.pennji.cn/api/webpack-plugin.html",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "dev": "rollup -c rollup.config.ts --configPlugin typescript --watch"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "@ai-request-guard/ai": "workspace:*",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^22.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
