{
  "name": "@ai-request-guard/core",
  "version": "0.2.0-alpha.9",
  "author": "Penn Ji",
  "description": "Frontend anti-corruption layer — isolate backend DTOs from view models with the adapter pattern",
  "keywords": [
    "anti-corruption-layer",
    "adapter",
    "frontend",
    "dto",
    "viewmodel",
    "schema",
    "mock",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jipengju-GitHub/ai-request-guard.git",
    "directory": "packages/core"
  },
  "homepage": "https://guard.pennji.cn/api/core.html",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "build:watch": "rollup -c rollup.config.ts --configPlugin typescript --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^22.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
