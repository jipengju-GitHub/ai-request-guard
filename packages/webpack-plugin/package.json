{
  "name": "@ai-request-guard/webpack-plugin",
  "version": "0.2.0-alpha.8",
  "description": "Webpack plugin for AIRequestGuard — schema diff HTML report via devServer",
  "keywords": [
    "webpack-plugin",
    "ai-request-guard",
    "schema-diff"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jipengju-GitHub/ai-request-guard.git",
    "directory": "packages/webpack-plugin"
  },
  "homepage": "https://guard.pennji.cn/api/webpack-plugin.html",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./report-sink": {
      "import": "./dist/report-sink.js",
      "require": "./dist/report-sink.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "report-sink.js",
    "report-sink.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "dev": "rollup -c rollup.config.ts --configPlugin typescript --watch"
  },
  "peerDependencies": {
    "webpack": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-request-guard/core": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^22.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
